/**
 * 진도율 제한 검사
 */
doLimitProgress = function() {
	//forLimitProgress.run();
	
	var courseActiveSeqTmp = $("#FormLimitProgress > input[name='courseActiveSeq']").val()
	var courseApplySeqTmp = $("#FormLimitProgress > input[name='courseApplySeq']").val();
	
	$.ajax("/usr/course/progress/limit.do", {
		type: "post",
		dataType: "json",
		data : { courseActiveSeq : courseActiveSeqTmp,
			     courseApplySeq : courseApplySeqTmp
				},
		async: false,
		success: function(data) {
			
			var form = UT.getById(forLearning.config.formId);
			var check = form.elements["completionStatus"].value;
			if(check == 'completed'){
				forLearning.run("continue");
			}else {
				if (data.result == true) {
					forLearning.run("continue");
				} else {
					var msg = "일별 제한진도율을 초과 하셨습니다";
// 					if (data.progressType == "month") {
// 						msg = "월별 제한진도율을 초과 하셨습니다";
// 					}
					if(data.progressType && data.progressType == 'day'){
						msg += ' (1일 '+(data.sumProgress ? data.sumProgress + '%' : '')+')';
					}else if(data.progressType && data.progressType == 'item'){
						msg += ' (1일 '+(data.sumItemCount ? data.sumItemCount + '차시' : '')+')';
					}
					
					$.alert({
						message : msg,
						button1 : {
							callback : function() {
								doRefresh();
							}
						}
					});
				}
			}
			
		}
    });

	return false; // 일단 멈추게 함. forLearning 의 재시작은 forLimitProgress의 complete에서.
};

