doLearning = function(mapPKs, capchaOrganizationCnt) {
	//학습 종료일 체크
	var nowDateTime = 99999999999999;
	var studyEndDateTime = "20260523235959";
	var studyEndMessage = "";
	if (studyEndDateTime && studyEndDateTime.length >= 8) {
		studyEndMessage += "학습 종료일은 " + studyEndDateTime.substr(0, 4) + "-" + studyEndDateTime.substr(4, 2) + "-" + studyEndDateTime.substr(6, 2) + "일 까지 입니다.<br/>";
	}
	studyEndMessage += "학습일이 종료되어 더이상 학습하기를 진행할 수 없습니다."; 
	$.ajax("/common/serverDateTime.jsp", {
		type: "post",
		dataType: "html",
		async: false,
		success: function(data) {
			$.each($(data), function(i, el) {
				if (el.tagName == "INPUT" && el.type == "hidden" && el.name == "nowDateTime") {
					nowDateTime = el.value;
				}
			});
		}
	});
	
	if(mapPKs.completionStatus == 'completed'){
		// 완료한것은 학습 가능
		studyEndDateTime = nowDateTime;
	}
	if (Number(nowDateTime) > Number(studyEndDateTime)) {
		$.alert({title:"학습일 종료", message:studyEndMessage, width:400});
		return;
	}
	
	/* PKs = mapPKs; */
	
	// 학습하기화면 form을 reset한다.
	UT.getById(forLearning.config.formId).reset();
	// 학습하기화면 form에 키값을 셋팅한다.
	UT.copyValueMapToForm(mapPKs, forLearning.config.formId);
	
	if (checkLearningCnt > 0) {
		//$.alert({message : "현재 학습 중입니다!!"});
		$.alert({message : "팝업 차단을 해제하거나 이미 진행 중인 학습창을 확인해주세요."});
		if (forLearning.config.popupWindow) {
			forLearning.config.popupWindow.focus();
		}
	} else {
		// 사이즈 고정 (.learningWindow width, height로 지정함)
		forLearning.config.options.width = 1023;
		forLearning.config.options.height = 690;
		forLearning.config.options.position = "CUSTOM";
		forLearning.config.options.top = 0;
		forLearning.config.options.left = 0;
		/* 2021.12.31 capchar 미사용 제거 요청 
		if(insuranceRefundYn == "Y"){
			if(capchaOrganizationCnt % 6 == 1){
				$("#FormLearning > input[name='capchaType']").val("진도_" + capchaOrganizationCnt);
				forCapchar.config.formId = "FormLearning";
				forCapchar.run();
			}else{
				doLearningRun();
			}
		}else{
			doLearningRun();
		} */
		
		doLearningRun();
	}
};

