        doLogin = function (param) {
            // 로그인 오류 후 모달창 쌓이는 증상 처리
            if (!$('#login_id').val() || !$('#login_pw').val()) {
                return;
            }
            var action = $.action("submit", {formId: "FormLogin"});
            FormLogin.elements["j_username"].value = FormLogin.elements["j_username"].value.trim();
            FormLogin.elements["user_id"].value = FormLogin.elements["j_username"].value;
            action.config.target = "hiddenframe";
            action.config.message.waiting = "처리 중 입니다";
            action.config.url = "/security/login";
            action.config.url += typeof param === "string" ? "?" + param : "";
            action.validator.set({
                title: "아이디",
                name: "j_username",
                data: ["!null"]
            });
            action.validator.set({
                title: "비밀번호",
                name: "j_password",
                data: ["!null"]
            });
            action.run();

            var form = UT.getById(action.config.formId);

            if (UT.getById("id_save").checked == true) {
                UT.setCookie("username", form.elements["j_username"].value, 60 * 60 * 24 * 30, "/", "", "");
                UT.setCookie("idSave", form.elements["id_save"].value, 60 * 60 * 24 * 30, "/", "", "");
            } else {
                UT.delCookie("username", "/", "", "");
                UT.delCookie("idSave", "/", "", "");
            }


