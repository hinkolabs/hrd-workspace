            //alert(location.pathname + location.search);
            //alert(sessionAlive);
            //var path = document.getElementById("path").value=document.history.go(-2);
            var $lb = $.loadingbar();
            $lb.show('<div><img src="https://web.kifin.or.kr/css/loading_spinner.svg" class="loading_spin" alt="loading..." /></div>', {modal: true});
            $('.ui-dialog-custom-message.ui-widget-content').css({backgroundColor: 'transparent', border: 0});
            var referrerUrl = getCookies('referrerUrl');
            var goMyPage = getCookies('myPage');
            var action = $.action();
            if (referrerUrl !== getCookies('myPage') && referrerUrl !== null /*&& referrerUrl !== getCookies('')*/ && referrerUrl !== '') {
                delCookie('referrerUrl');
                
                if(referrerUrl.indexOf('referrerUrl=') > 0){
                	referrerUrl = referrerUrl.substring(referrerUrl.indexOf('=')+1, referrerUrl.length)
                }
                referrerUrl = referrerUrl.replaceAll(/</g, "&");
                referrerUrl = referrerUrl.replaceAll("%3C", "&");
                referrerUrl = referrerUrl.replaceAll("&lt;", "&");
                
                var params = referrerUrl.substring(referrerUrl.indexOf('?') + 1, referrerUrl.length);
                params = params.split("&");
                var key, value;
                for(var i = 0 ; i < params.length ; i++){
                	key = params[i].split("=")[0];
                	value = params[i].split("=")[1];
                	if(value != ''){
                	   $("[name='" + key + "']").val(value);
                	}
                }
                
                if(referrerUrl.indexOf('?') > 0){
                	referrerUrl = referrerUrl.substring(0, referrerUrl.indexOf('?'));
                }
                
                action.config.url = "https://www.kifin.or.kr" + referrerUrl;
                action.config.formId = "FormRedirect";
                $("[name='currentMenuId']").val("");

                // action.config.url = '' + referrerUrl + '';
            } else if (goMyPage !== null && goMyPage !== getCookies('referrerUrl') && goMyPage !== getCookies('')) {
                delCookie('myPage');
                action.config.url = "https://www.kifin.or.kr" + goMyPage;
            } else {
                action.config.url = "/usr/common/greeting.do";
            }
            action.run();
        };

