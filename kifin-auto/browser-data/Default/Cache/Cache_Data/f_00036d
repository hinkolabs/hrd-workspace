		$("#interestSettingPopup").find("input:checkbox").each(function() {
			if(this.checked) {
				checkedValue += ',' + this.value;
			}
		});
	}
	
	if (checkedValue == "") {
		$.alert({
			message : "관심분야를 선택해주세요",
			overflow : false
		});
		return false;
	}
	
	var interestCdVal = checkedValue.substr(1);
	
	$.ajax("/usr/member/user/interest/update.do", {
		type: "post",
		dataType: "json",
		data : {interestCd : interestCdVal},
		async: false,
		success: function(data) {
			if(data.success) {
				$("#interestSettingPopup").dialog("close");
				
				if (type == "2") {
					location.reload();
