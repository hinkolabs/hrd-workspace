 		    	}else{
	 		    	setPlayInfoAndRun(lastStudyPage);
 		    	}
 				
 		    }
		    
		}
		
		function updateVolume(pageY){
			
			var volume = $('.volume');
	        var percentage;
			var position = pageY - volume.offset().top;
	            percentage = 100 * position / volume.height();

	        if (percentage > 99) {
	            percentage = 100;
	        }
	        if (percentage < 0) {
	            percentage = 0;
	        }
	        
	        
	      	//update volume bar and video volume
	      	var video = document.getElementById('tVideo');
	      	if(video){
				$('.volumeBar').css('top', parseInt(percentage) + '%');
				video.volume = (100 - percentage) / 100;
	      	}
		}
		
		function updateStepVolume(isUp){
			debugger;
			var video = document.getElementById('tVideo');
	      	if(video){
	      		var addVol = isUp ? 0.05 : -0.05;
	      		var changeVol = video.volume + addVol;
	      		var percentage = changeVol > 1 ? 0 : 100 - (changeVol * 100);
	      		percentage = percentage > 100 ? 100 : percentage;
				$('.volumeBar').css('top', percentage + '%');
				video.volume = (100 - percentage) / 100;
	      	}
		}
