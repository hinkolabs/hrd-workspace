		function saveTempProgress() {
			var video = document.getElementById('tVideo');
			// 복습하기일 경우 진도 저장 X
			var completionStatus = "incomplete";
			var studyEndDate =  "20260523235959";
			var nowDate = new Date(+new Date() + 3240 * 10000).toISOString().replace("T","").replace(/\..*/, "").replaceAll("-","").replaceAll(":","");
			//studyEndDate = studyEndDate.substring(0,4) + '-' + studyEndDate.substring(4,6) + '-' + studyEndDate.substring(6,8);
			/* 2022.05.18 복습과정 진도 저장되도록 주석처리함 */
			/* 23.02.13 최초 학습일시, 최종학습일시에 영향 안주도록 복습하기의 경우 플래그값 추가 */
			var courseStatus = "";			
 			if(completionStatus == "completed" && nowDate > studyEndDate){
 				courseStatus = "COMP";
 			} 
			/* 23.08.09 학습종료일이 지나면 강제 종료 진도저장 X */
 			if(completionStatus == "incomplete" && nowDate > studyEndDate){
 				video.pause();
 				$.alert({
					message : "학습종료일이 지났습니다. 학습을 종료합니다.",
					button1 : {
						callback : function() {
							self.close();
						}
					}
				});
 			}
		    // sinf, saveSinfTime 세팅
		    var currentFramePage = $('#currentFramePageVal').val().length == 1 ? "0" + $('#currentFramePageVal').val() : $('#currentFramePageVal').val(); 
		    var totalFramePage = $('#totalFramePageVal').val().length == 1 ? "0" + $('#totalFramePageVal').val() : $('#totalFramePageVal').val(); ;
			var sinf = currentFramePage + totalFramePage;
			
			var playTime = $('.play_time').text().split('/')[0].trim();
			var parts = playTime.split(':');
			var saveSinfTime = '';

			if (parts.length === 2) {
			    // mm:ss 형식
			    saveSinfTime = parts[0] + ':' + parts[1];
			} else if (parts.length === 3) {
			    // hh:mm:ss 형식
			    var hour = parseInt(parts[0], 10);
			    var minute = parseInt(parts[1], 10);
			    var totalMinute = hour * 60 + minute;
			    saveSinfTime = totalMinute + ':' + parts[2];
			} else {
			    saveSinfTime = '';
			}
			
			if (crsSessId != 8212 && crsSessId != 8207 && crsSessId != 9260 && crsSessId != 9279) {
				if (reStudyYn == '1') return;
				if (previewYn == 'Y') return;
