		                    <div><em id="currentFramePage">1</em> <span id="totalFramePage">/ 11</span></div>
		                   <button class="p_paging_btn next" id="nextBtn" onclick="setPlayInfoAndRun('01', true)"></button>
		                    <input type="hidden" id="currentFramePageVal" name="currentFramePageVal" value="1">
		                    <input type="hidden" id="totalFramePageVal" name="totalFramePageVal" value="11">
		                    <input type="hidden" id="frameSeq" name="frameSeq" value="">
		                    <input type="hidden" id="deviceTpCd" name="deviceTpCd" value="">
