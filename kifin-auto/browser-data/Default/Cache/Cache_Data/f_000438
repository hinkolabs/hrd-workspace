				video.requestFullScreen();
			}else if(video.mozRequestFullScreen){
				video.mozRequestFullScreen();
			}else if(video.webkitRequestFullScreen){
				video.webkitRequestFullScreen();
			}else if(video.webkitEnterFullScreen){
				video.webkitEnterFullScreen();
			}
		}
		
		function updatePlayTime(){
			var video = document.getElementById('tVideo');
			var duration = convertMS(video.duration);
			var organizationSeq = "8758";
			var frameSeq = $('#frameSeq').val();
			$('.play_time').attr('play_time', duration);
			$('.play_time').text('00:00 / ' + duration);
			
			// 가장 최근에 본시간이 100%일경우 0초로 리셋
			if (video.duration <= (saveSinfTimeSeconds + 2)) {
				video.currentTime = 0;
				saveSinfTimeSeconds = 0;
				checkSeconds = 0;
				saveSinfTime = '00:00';
				$('#'+frameSeq+'_saveTime').val(saveSinfTime);
				
			} 
			
			if(video.duration && video.duration > 0){
				$.ajax("/learning/api/simple/updatePlayTime.do", {
					type: "post",
					dataType: "json",
					data : { 
						organizationSeq : organizationSeq,					
						frameSeq : frameSeq,
