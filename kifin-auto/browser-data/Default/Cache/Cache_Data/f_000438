			$.ajax(saveTempjsp, {
				type: "post",
				data : {
					'crsSessId' : crsSessId
					, 'atlcNo' : atlcNo
					, 'sbjtId' : sbjtId
					, 'lectPldcNo' : lectPldcNo
					, 'sinf' : sinf
					, 'opinNo' : ''
					, 'opinTit' : ''
					, 'opinCn' : ''
					, 'pgTit' : ''
					, 'memoCn' : ''
					, 'saveSinfTime' : saveSinfTime
					, 'courseActiveSeq' : crsSessId
					, 'courseApplySeq' : atlcNo
					, 'currentMenuId' : '010001001'
					, 'frameSeq' : $('#frameSeq').val()
					, 'deviceTpCd' : $('#deviceTpCd').val()
